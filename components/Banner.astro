---
// Starlight's page banner (the `banner` frontmatter), plus a notice on every page of the development
// docs that links to the same page in the stable docs. The theme plugin replaces Banner with this one.
import theme from 'virtual:starlight-theme/config';

const { banner } = Astro.locals.starlightRoute.entry.data;
const versions = theme.versions;
const stable = versions && versions.stable + Astro.url.pathname.slice(versions.dev.length);
---

{banner && <div class="sl-banner" data-pagefind-ignore set:html={banner.content} />}
{
	versions?.current === 'dev' && (
		<div class="sl-banner dev-notice" data-pagefind-ignore>
			These are the docs of the development version (the <code>{theme.branch}</code> branch). See the{' '}
			<a href={stable}>docs of the latest release</a>.
		</div>
	)
}

<style>
	@layer starlight.core {
		.sl-banner {
			--__sl-banner-text: var(--sl-color-banner-text, var(--sl-color-text-invert));
			padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
			background-color: var(--sl-color-banner-bg, var(--sl-color-bg-accent));
			color: var(--__sl-banner-text);
			line-height: var(--sl-line-height-headings);
			text-align: center;
			text-wrap: balance;
			box-shadow: var(--sl-shadow-sm);
		}
		.sl-banner :global(a) {
			color: var(--__sl-banner-text);
		}
	}
	.dev-notice {
		font-size: var(--sl-text-sm);
		background-color: var(--sl-color-accent-low);
		--__sl-banner-text: var(--sl-color-text);
	}
	.dev-notice code {
		font-size: inherit;
	}
</style>
