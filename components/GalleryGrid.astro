---
// The grid of cards on the gallery page, one per example, under a heading per group, with a
// filter box (written by the starlight-gallery tool). The index page of the notebooks has one too
// (starlight-notebooks).
import { withBase } from '../utils/base';
import PlotlyFigure from './PlotlyFigure.astro';

export interface Item {
	title: string;
	summary: string;
	/** Site-root path of the example's page. */
	href: string;
	/** Heading of the group the example belongs to; empty for none. */
	group: string;
	/** The first figure of the example, if it has run. */
	thumbnail: { kind: 'plotly' | 'png'; src: string } | null;
	/** Text in place of a missing thumbnail. Default "not run". */
	placeholder?: string;
}
export interface Props {
	items: Item[];
	/** Show the filter box. Default true. */
	filter?: boolean;
	/** Placeholder of the filter box. */
	filterLabel?: string;
}
const { items, filter = true, filterLabel = 'Filter examples…' } = Astro.props;
const groups = [...new Set(items.map((item) => item.group))].map((group) => ({
	name: group,
	items: items.filter((item) => item.group === group),
}));
---

<div class="gallery not-content">
	{filter && <input class="gallery-filter" type="search" placeholder={filterLabel} aria-label={filterLabel.replace(/…$/, '')} data-gallery-filter />}
	{
		groups.map((group) => (
			<section class="gallery-group" data-gallery-group>
				{group.name && <h2 class="gallery-heading">{group.name}</h2>}
				<ul class="gallery-grid">
					{group.items.map((item) => (
						<li data-gallery-item data-text={`${item.title} ${item.summary}`.toLowerCase()}>
							<a class="gallery-card" href={withBase(item.href)}>
								<div class="gallery-thumb">
									{item.thumbnail?.kind === 'plotly' && <PlotlyFigure src={item.thumbnail.src} thumbnail />}
									{item.thumbnail?.kind === 'png' && <img src={withBase(item.thumbnail.src)} alt="" loading="lazy" />}
									{!item.thumbnail && <span class="gallery-empty">{item.placeholder ?? 'not run'}</span>}
								</div>
								<div class="gallery-text">
									<h3>{item.title}</h3>
									<p>{item.summary}</p>
								</div>
							</a>
						</li>
					))}
				</ul>
			</section>
		))
	}
	<p class="gallery-none" hidden>Nothing matches.</p>
</div>

<script>
	const input = document.querySelector<HTMLInputElement>('[data-gallery-filter]');
	input?.addEventListener('input', () => {
		const query = input.value.trim().toLowerCase();
		let shown = 0;
		document.querySelectorAll<HTMLElement>('[data-gallery-item]').forEach((item) => {
			const match = !query || (item.dataset.text ?? '').includes(query);
			item.hidden = !match;
			if (match) shown += 1;
		});
		document.querySelectorAll<HTMLElement>('[data-gallery-group]').forEach((group) => {
			group.hidden = !group.querySelector('[data-gallery-item]:not([hidden])');
		});
		document.querySelector<HTMLElement>('.gallery-none')!.hidden = shown > 0;
	});
</script>

<style>
	.gallery-filter {
		box-sizing: border-box;
		width: 100%;
		max-width: 22rem;
		margin-bottom: 1.5rem;
		padding: 0.55rem 0.9rem;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 999px;
		background: var(--sl-color-bg-inline-code);
		color: var(--sl-color-text);
		font: inherit;
		font-size: var(--sl-text-sm);
	}
	.gallery-filter:focus-visible {
		outline: 2px solid var(--sl-color-text-accent);
		outline-offset: 2px;
	}
	.gallery-heading {
		margin: 2rem 0 1rem;
		font-size: var(--sl-text-xl);
		font-weight: 600;
		letter-spacing: -0.01em;
	}
	.gallery-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
		gap: 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.gallery-grid > li[hidden],
	.gallery-group[hidden] {
		display: none;
	}
	.gallery-card {
		display: flex;
		flex-direction: column;
		height: 100%;
		overflow: hidden;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.9rem;
		background: color-mix(in srgb, var(--sl-color-gray-5, #888) 8%, transparent);
		color: inherit;
		text-decoration: none;
		transition:
			transform 0.18s ease,
			border-color 0.18s ease,
			box-shadow 0.18s ease;
	}
	.gallery-card:hover,
	.gallery-card:focus-visible {
		transform: translateY(-3px);
		border-color: var(--sl-color-text-accent);
		box-shadow: 0 10px 28px -12px color-mix(in srgb, var(--sl-color-text-accent) 55%, transparent);
	}
	.gallery-thumb {
		display: flex;
		align-items: center;
		justify-content: center;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		border-bottom: 1px solid var(--sl-color-hairline);
		background: radial-gradient(120% 120% at 0% 0%, var(--sl-color-accent-low), transparent 70%);
	}
	.gallery-thumb img {
		width: 100%;
		height: 100%;
		object-fit: contain;
		background: white;
	}
	.gallery-empty {
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
	}
	.gallery-text {
		padding: 0.9rem 1.1rem 1.1rem;
	}
	.gallery-text h3 {
		margin: 0 0 0.35rem;
		font-size: var(--sl-text-lg);
		font-weight: 600;
		line-height: 1.25;
	}
	.gallery-text p {
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
		margin: 0;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		line-height: 1.5;
	}
	.gallery-none {
		color: var(--sl-color-gray-3);
	}
	@media (prefers-reduced-motion: reduce) {
		.gallery-card {
			transition: none;
		}
		.gallery-card:hover,
		.gallery-card:focus-visible {
			transform: none;
		}
	}
</style>
