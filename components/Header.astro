---
// A top nav bar with the site title, a row of section links, then search, the stable/dev switch,
// the projects menu (built in, then replaced by projects.json when it loads), socials and theme. Starlight's default Header has no link row, so the theme
// plugin replaces it with this one.
import config from 'virtual:starlight/user-config';
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import theme from 'virtual:starlight-theme/config';
import { withBase } from '../utils/base';

const shouldRenderSearch =
	config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';

// from the `nav` option of defineDocs / the theme plugin
const navLinks = theme.nav.map((link) => ({ ...link, href: withBase(link.link), section: withBase(link.section) }));

const { pathname } = Astro.url;
const isCurrent = (section: string) => pathname.startsWith(section);

// the same page in the other version (the stable base is a prefix of the dev one)
const versions = theme.versions;
const page = versions && pathname.slice(versions[versions.current].length);
const versionLinks = versions
	? (['stable', 'dev'] as const).map((name) => ({ name, href: versions[name] + page, current: versions.current === name }))
	: [];
---

<div class="header">
	<div class="title-wrapper sl-flex">
		<SiteTitle />
	</div>
	<nav class="topnav sl-hidden md:sl-flex" aria-label="Primary">
		{
			navLinks.map((link) => (
				<a href={link.href} class:list={['topnav-link', { current: isCurrent(link.section) }]}>
					{link.label}
				</a>
			))
		}
	</nav>
	<div class="sl-flex print:hidden">
		{shouldRenderSearch && <Search />}
	</div>
	<div class="sl-hidden md:sl-flex print:hidden right-group">
		{
			versionLinks.length > 0 && (
				<nav class="versions" aria-label="Version">
					{versionLinks.map((link) => (
						<a href={link.href} class:list={{ current: link.current }} aria-current={link.current ? 'page' : undefined}>
							{link.name}
						</a>
					))}
				</nav>
			)
		}
		{
			(theme.projects.length > 0 || theme.projectsUrl) && (
				<details
					class="projects-menu"
					data-projects-menu
					data-projects-url={theme.projectsUrl}
					data-repository={theme.repository}
					hidden={theme.projects.length === 0}
				>
					<summary>Projects</summary>
					<ul>
						{theme.projects.map((project) => (
							<li>
								<a href={project.href} aria-current={project.current ? 'page' : undefined}>
									<span class="project-title">{project.title}</span>
									{project.description && <span class="project-description">{project.description}</span>}
								</a>
							</li>
						))}
					</ul>
					{/* rendered here so the entries the script adds get the scoped styles */}
					<template>
						<li>
							<a>
								<span class="project-title" />
								<span class="project-description" />
							</a>
						</li>
					</template>
				</details>
			)
		}
		<div class="sl-flex social-icons">
			<SocialIcons />
		</div>
		<ThemeSelect />
		<LanguageSelect />
	</div>
</div>

<script>
	import { menuEntries, type MenuEntry } from '../lib/project-menu.ts';

	const menu = document.querySelector<HTMLDetailsElement>('[data-projects-menu]');

	// the menu as it is now in projects.json; the built-in one stays when that does not load
	function render(entries: MenuEntry[]) {
		const list = menu!.querySelector('ul')!;
		const template = menu!.querySelector('template')!;
		list.replaceChildren(
			...entries.map((entry) => {
				const item = template.content.firstElementChild!.cloneNode(true) as HTMLLIElement;
				const link = item.querySelector('a')!;
				link.href = entry.href;
				if (entry.current) link.setAttribute('aria-current', 'page');
				link.querySelector('.project-title')!.textContent = entry.title;
				const description = link.querySelector('.project-description')!;
				if (entry.description) description.textContent = entry.description;
				else description.remove();
				return item;
			})
		);
		menu!.hidden = entries.length === 0;
	}

	const url = menu?.dataset.projectsUrl;
	if (menu && url) {
		const [owner, repo] = (menu.dataset.repository ?? '').split('/');
		fetch(url)
			.then((response) => (response.ok ? response.json() : Promise.reject(response.status)))
			.then((projects) => {
				const entries = menuEntries(projects, owner, repo);
				if (entries.length > 0) render(entries);
			})
			.catch(() => {});
	}

	// close the projects menu on a click elsewhere or Escape
	if (menu) {
		document.addEventListener('click', (event) => {
			if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
		});
		menu.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && menu.open) {
				menu.open = false;
				menu.querySelector('summary')?.focus();
			}
		});
	}
</script>

<style>
	@layer starlight.core {
		.header {
			display: flex;
			gap: var(--sl-nav-gap);
			justify-content: space-between;
			align-items: center;
			height: 100%;
		}

		.title-wrapper {
			overflow: clip;
			padding: 0.25rem;
			margin: -0.25rem;
			min-width: 0;
			flex-shrink: 0;
		}

		.topnav {
			flex: 1;
			gap: 1.75rem;
			align-items: center;
			padding-inline-start: 1.5rem;
			min-width: 0;
		}

		.topnav-link {
			font-size: var(--sl-text-sm);
			font-weight: 600;
			text-decoration: none;
			white-space: nowrap;
			color: var(--sl-color-gray-2);
			padding-block: 0.25rem;
			border-bottom: 2px solid transparent;
		}

		.topnav-link:hover {
			color: var(--sl-color-white);
		}

		.topnav-link.current {
			color: var(--sl-color-text-accent);
			border-bottom-color: var(--sl-color-text-accent);
		}

		.right-group,
		.social-icons {
			gap: 1rem;
			align-items: center;
		}

		.versions {
			display: flex;
			border: 1px solid var(--sl-color-hairline-light);
			border-radius: 0.25rem;
			overflow: hidden;
			font-size: var(--sl-text-xs);
			font-weight: 600;
		}

		.versions a {
			padding: 0.15rem 0.5rem;
			color: var(--sl-color-gray-2);
			text-decoration: none;
		}

		.versions a:hover {
			color: var(--sl-color-white);
		}

		.versions a.current {
			background: var(--sl-color-accent-low);
			color: var(--sl-color-text-accent);
		}

		.projects-menu {
			position: relative;
			font-size: var(--sl-text-sm);
		}

		.projects-menu summary {
			cursor: pointer;
			list-style: none;
			font-weight: 600;
			color: var(--sl-color-gray-2);
			white-space: nowrap;
		}

		.projects-menu summary::-webkit-details-marker {
			display: none;
		}

		.projects-menu summary::after {
			content: '▾';
			margin-inline-start: 0.3rem;
			font-size: 0.8em;
		}

		.projects-menu summary:hover,
		.projects-menu[open] summary {
			color: var(--sl-color-white);
		}

		.projects-menu ul {
			position: absolute;
			inset-inline-end: 0;
			top: calc(100% + 0.75rem);
			z-index: 20;
			width: 19rem;
			margin: 0;
			padding: 0.4rem;
			list-style: none;
			border: 1px solid var(--sl-color-hairline-light);
			border-radius: 0.5rem;
			background: var(--sl-color-bg-nav);
			box-shadow: var(--sl-shadow-md);
			max-height: calc(100vh - var(--sl-nav-height) - 2rem);
			overflow-y: auto;
		}

		.projects-menu li a {
			display: flex;
			flex-direction: column;
			padding: 0.45rem 0.65rem;
			border-radius: 0.3rem;
			text-decoration: none;
		}

		.projects-menu li a:hover {
			background: var(--sl-color-accent-low);
		}

		.project-title {
			font-weight: 600;
			color: var(--sl-color-white);
		}

		.projects-menu a[aria-current] .project-title {
			color: var(--sl-color-text-accent);
		}

		.project-description {
			font-size: var(--sl-text-xs);
			color: var(--sl-color-gray-3);
		}

		.social-icons::after {
			content: '';
			height: 2rem;
			border-inline-end: 1px solid var(--sl-color-gray-5);
		}
	}
</style>
