---
// The strip at the top of a tutorial page: download the notebook, open it on GitHub, and run it
// in Colab or Binder if the site asks for that (`launch` of defineDocs); written by the
// starlight-notebooks tool.
import theme from 'virtual:starlight-theme/config';
import { withBase } from '../utils/base';

export interface Props {
	/** Site-root path of the downloadable notebook under public/, e.g. "/tutorials/first-steps/first_steps.ipynb". */
	download: string;
	/** Repository path of the notebook, e.g. "tutorials/first_steps.ipynb". */
	source: string;
	/** "executed" (outputs from a run at build time) or "not run". */
	status?: 'executed' | 'not run';
	/** Show the site's launch buttons; false for a notebook that runs under MPI or opts out. */
	launch?: boolean;
}
const { download, source, status = 'executed', launch = true } = Astro.props;
const filename = download.split('/').at(-1) ?? 'tutorial.ipynb';
const github = `https://github.com/${theme.repository}/blob/${theme.branch}/${source}`;
const services = {
	colab: { label: 'Open in Colab', href: `https://colab.research.google.com/github/${theme.repository}/blob/${theme.branch}/${source}` },
	binder: { label: 'Launch Binder', href: `https://mybinder.org/v2/gh/${theme.repository}/${theme.branch}?labpath=${encodeURIComponent(source)}` },
};
const launchLinks = launch ? theme.launch.map((service) => services[service]) : [];
const notes = {
	executed: 'Run when the site was built.',
	'not run': 'Not run for this build: the outputs are missing.',
};
---

<div class="notebook-header not-content">
	<a class="notebook-button" href={withBase(download)} download={filename} data-notebook-download>Download notebook</a>
	<a class="notebook-button secondary" href={github}>View on GitHub</a>
	{launchLinks.map((link) => <a class="notebook-button secondary" href={link.href}>{link.label}</a>)}
	<span class="notebook-note">{notes[status]}</span>
</div>

<script>
	document.querySelectorAll<HTMLAnchorElement>('a[data-notebook-download]').forEach((link) => {
		link.addEventListener('click', async (event) => {
			event.preventDefault();
			try {
				const response = await fetch(link.href);
				if (!response.ok) throw new Error(`Notebook download failed: ${response.status}`);
				const blob = new Blob([await response.arrayBuffer()], { type: 'application/x-ipynb+json' });
				const url = URL.createObjectURL(blob);
				const anchor = document.createElement('a');
				anchor.href = url;
				anchor.download = link.download;
				anchor.click();
				setTimeout(() => URL.revokeObjectURL(url), 1000);
			} catch {
				const anchor = document.createElement('a');
				anchor.href = link.href;
				anchor.download = link.download;
				anchor.click();
			}
		});
	});
</script>

<style>
	.notebook-header {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.6rem 0.8rem;
		margin-block: 0 1.5rem;
		font-size: var(--sl-text-sm);
	}
	.notebook-button {
		padding: 0.35rem 0.9rem;
		border: 1px solid var(--sl-color-text-accent);
		border-radius: 999px;
		background: var(--sl-color-text-accent);
		color: var(--sl-color-text-invert);
		text-decoration: none;
		font-weight: 600;
	}
	.notebook-button.secondary {
		background: transparent;
		color: var(--sl-color-text-accent);
	}
	.notebook-note {
		color: var(--sl-color-gray-3);
	}
</style>
