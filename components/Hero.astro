---
// Starlight's hero (the `hero` frontmatter of a home page) on a header picture across the whole
// width: the site's own animated figure from `src/assets/hero.svg` when it has one (written with
// plasma-plots' `plasma_plots.hero`, coloured by the classes below), otherwise streamlines of the flow
// past a cylinder in the accent colour, a different one per site (seeded by the site title);
// `heroBackground` in the frontmatter sets an image instead, or `false` for none. The animations
// stand still for readers who prefer reduced motion. Above the title, the latest release (lib/release.ts); below the buttons,
// `heroInstall` from the frontmatter as a command to copy. The theme plugin replaces Hero with this one.
import { Image } from 'astro:assets';
import config from 'virtual:starlight/user-config';
import DraftContentNotice from 'virtual:starlight/components/DraftContentNotice';
import { LinkButton } from '@astrojs/starlight/components';
import theme from 'virtual:starlight-theme/config';
import { heroPattern } from '../lib/hero-pattern.ts';
import { latestRelease } from '../lib/release.ts';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, image, actions = [] } = data.hero || {};
const { heroBackground: background, heroInstall: install } = data as {
	heroBackground?: ImageMetadata | { dark: ImageMetadata; light: ImageMetadata } | false;
	heroInstall?: string;
};
const release = await latestRelease(theme.release);

const imageAttrs = {
	loading: 'eager' as const,
	decoding: 'async' as const,
	width: 400,
	height: 400,
	alt: image?.alt || '',
};

let darkImage: ImageMetadata | undefined;
let lightImage: ImageMetadata | undefined;
let rawHtml: string | undefined;
if (image) {
	if ('file' in image) {
		darkImage = image.file;
	} else if ('dark' in image) {
		darkImage = image.dark;
		lightImage = image.light;
	} else {
		rawHtml = image.html;
	}
}

// the site's figure, looked up in the project that builds (a leading / is its root)
const figures = import.meta.glob<string>('/src/assets/hero.svg', { query: '?raw', import: 'default', eager: true });
const figure = background === undefined ? Object.values(figures)[0] : undefined;

const siteTitle = typeof config.title === 'string' ? config.title : Object.values(config.title)[0];
const pattern = background === undefined && !figure ? heroPattern(siteTitle ?? data.title) : undefined;
const backgrounds = background ? ('dark' in background ? [background.dark, background.light] : [background]) : [];
---

<div class:list={['hero', { 'has-backdrop': background !== false }]}>
	{
		background !== false && (
			<div class="backdrop" aria-hidden="true">
				{figure && <Fragment set:html={figure.replace('<svg ', '<svg class="hero-figure" ')} />}
				{pattern && (
					<svg class="streamlines" viewBox={`0 0 ${pattern.width} ${pattern.height}`} preserveAspectRatio="xMidYMid slice">
						<g fill="none" stroke-width="1.5">
							{pattern.lines.map((line) => (
								<path d={line.d} stroke-opacity={line.opacity} />
							))}
						</g>
						<circle class="cylinder" cx={pattern.circle.cx} cy={pattern.circle.cy} r={pattern.circle.r} />
						{pattern.dots.map((dot) => (
							<circle class="tracer" r="4">
								<animateMotion
									dur={`${dot.duration}s`}
									begin={`-${dot.offset}s`}
									repeatCount="indefinite"
									path={pattern.lines[dot.line].d}
								/>
							</circle>
						))}
					</svg>
				)}
				{backgrounds.map((file, index) => (
					<Image
						src={file}
						alt=""
						loading="eager"
						widths={[800, 1600, 2400]}
						sizes="100vw"
						class:list={[
							'backdrop-image',
							{ 'light:sl-hidden': backgrounds.length > 1 && index === 0, 'dark:sl-hidden': index === 1 },
						]}
					/>
				))}
			</div>
		)
	}
	{darkImage && <Image src={darkImage} {...imageAttrs} class:list={['side', { 'light:sl-hidden': Boolean(lightImage) }]} />}
	{lightImage && <Image src={lightImage} {...imageAttrs} class="side dark:sl-hidden" />}
	{rawHtml && <div class="side hero-html sl-flex" set:html={rawHtml} />}
	<div class="sl-flex stack">
		<div class="sl-flex copy">
			{
				release && (
					<a class="release" href={release.href}>
						<span>Latest release</span> v{release.version}
					</a>
				)
			}
			<h1 id="_top" data-page-title set:html={title} />
			{data.draft && <DraftContentNotice />}
			{tagline && <div class="tagline" set:html={tagline} />}
		</div>
		{
			actions.length > 0 && (
				<div class="sl-flex actions">
					{actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
						<LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
							{text}
							{icon?.html && <Fragment set:html={icon.html} />}
						</LinkButton>
					))}
				</div>
			)
		}
		{
			install && (
				<div class="install sl-flex">
					<code>
						<span class="prompt" aria-hidden="true">$</span> {install}
					</code>
					<button type="button" data-copy={install} aria-label="Copy the command">
						Copy
					</button>
				</div>
			)
		}
	</div>
</div>

<script>
	// the dots stand still for readers who prefer reduced motion, spread along their lines
	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
	const svg = document.querySelector<SVGSVGElement>('.hero .backdrop svg');
	const apply = () => (reduce.matches ? svg?.pauseAnimations() : svg?.unpauseAnimations());
	apply();
	reduce.addEventListener('change', apply);

	for (const button of document.querySelectorAll<HTMLButtonElement>('.hero [data-copy]')) {
		button.addEventListener('click', async () => {
			await navigator.clipboard.writeText(button.dataset.copy ?? '');
			button.textContent = 'Copied';
			setTimeout(() => (button.textContent = 'Copy'), 1500);
		});
	}
</script>

<style>
	.hero {
		position: relative;
		isolation: isolate;
		display: grid;
		grid-template-columns: 100%;
		align-items: center;
		gap: 1rem;
		padding-block: 3rem 2.5rem;
	}

	/* the picture spans the viewport, from the header down to the end of the hero */
	.backdrop {
		position: absolute;
		z-index: -1;
		top: -1.5rem;
		bottom: 0;
		left: calc(50% - 50vw);
		width: 100vw;
		overflow: hidden;
		border-bottom: 1px solid var(--sl-color-hairline);
		background:
			radial-gradient(ellipse at 75% 50%, var(--sl-color-accent-low), transparent 70%),
			var(--sl-color-bg);
	}

	.streamlines,
	.backdrop :global(.hero-figure),
	.backdrop-image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		/* faint behind the text on small screens */
		opacity: 0.35;
	}

	.streamlines {
		stroke: var(--sl-color-accent);
	}

	/* the tones of a plasma_plots.hero figure: s- strokes, f- fills */
	.backdrop :global(.s-accent) { stroke: var(--sl-color-accent); }
	.backdrop :global(.s-high) { stroke: var(--sl-color-accent-high); }
	.backdrop :global(.s-low) { stroke: var(--sl-color-accent-low); }
	.backdrop :global(.s-muted) { stroke: var(--sl-color-gray-4); }
	.backdrop :global(.s-bg) { stroke: var(--sl-color-bg); }
	.backdrop :global(.f-accent) { fill: var(--sl-color-accent); }
	.backdrop :global(.f-high) { fill: var(--sl-color-accent-high); }
	.backdrop :global(.f-low) { fill: var(--sl-color-accent-low); }
	.backdrop :global(.f-muted) { fill: var(--sl-color-gray-4); }
	.backdrop :global(.f-bg) { fill: var(--sl-color-bg); }

	.cylinder {
		fill: var(--sl-color-bg);
		stroke: var(--sl-color-accent);
		stroke-width: 2.5;
	}

	.tracer {
		fill: var(--sl-color-accent-high);
	}

	.side {
		object-fit: contain;
		width: min(70%, 20rem);
		height: auto;
		margin-inline: auto;
	}

	.stack {
		flex-direction: column;
		gap: clamp(1.5rem, calc(1.5rem + 1vw), 2rem);
		text-align: center;
	}

	.copy {
		flex-direction: column;
		gap: 1rem;
		align-items: center;
	}

	.copy > * {
		max-width: 50ch;
	}

	h1 {
		font-size: clamp(var(--sl-text-4xl), calc(0.25rem + 6vw), var(--sl-text-6xl));
		line-height: var(--sl-line-height-headings);
		font-weight: 700;
		letter-spacing: -0.02em;
		color: var(--sl-color-white);
	}

	.tagline {
		font-size: clamp(var(--sl-text-base), calc(0.0625rem + 2vw), var(--sl-text-xl));
		color: var(--sl-color-gray-2);
		text-wrap: balance;
	}

	.actions {
		gap: 1rem 2rem;
		flex-wrap: wrap;
		justify-content: center;
	}

	.release {
		padding: 0.15rem 0.75rem;
		border: 1px solid var(--sl-color-accent);
		border-radius: 999px;
		background: color-mix(in srgb, var(--sl-color-bg) 70%, transparent);
		font-size: var(--sl-text-sm);
		font-weight: 600;
		color: var(--sl-color-text-accent);
		text-decoration: none;
	}
	.release span {
		font-weight: 400;
		color: var(--sl-color-gray-2);
	}
	.release:hover {
		background: var(--sl-color-accent-low);
	}

	.install {
		align-self: center;
		align-items: center;
		gap: 0.75rem;
		max-width: 100%;
		padding: 0.5rem 0.5rem 0.5rem 1rem;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 0.25rem;
		background: color-mix(in srgb, var(--sl-color-bg-inline-code) 85%, transparent);
	}
	.install code {
		overflow-x: auto;
		white-space: nowrap;
		font-size: var(--sl-text-sm);
		background: none;
		padding: 0;
	}
	.install .prompt {
		color: var(--sl-color-gray-3);
		user-select: none;
	}
	.install button {
		flex-shrink: 0;
		padding: 0.25rem 0.6rem;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 0.25rem;
		background: var(--sl-color-bg);
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-xs);
		cursor: pointer;
	}
	.install button:hover {
		color: var(--sl-color-accent);
		border-color: var(--sl-color-accent);
	}

	@media (min-width: 50rem) {
		.hero {
			grid-template-columns: 7fr 4fr;
			gap: 3%;
			padding-block: clamp(3rem, calc(1rem + 10vmin), 8rem);
		}

		.side {
			order: 2;
			width: min(100%, 25rem);
		}

		.stack {
			text-align: start;
		}

		.copy {
			align-items: flex-start;
		}

		.actions {
			justify-content: flex-start;
		}

		.install {
			align-self: flex-start;
		}

		/* full strength on the right, fading out behind the text on the left */
		.streamlines,
		.backdrop :global(.hero-figure),
		.backdrop-image {
			opacity: 1;
			mask-image: linear-gradient(to right, transparent 15%, #000 55%);
		}
	}
</style>
