---
// An interactive Plotly figure, loaded from the JSON a gallery script's `fig.show()` left under
// public/ (written by the starlight-gallery tool). plotly.js is a separate chunk that is fetched
// only when a figure scrolls into view, and the figure follows the site's light/dark theme: text,
// grid and backgrounds, the data palette (--mm-data-1..8 in styles/theme.css) for the traces in
// a default colour, and the text colour for black ones. A web figure (maxplotlib.web, `*.plotly.json`) adds hints in
// layout.meta.web: its aspect ratio, a text alternative and a white plot area (see the README).
import { withBase } from '../utils/base';

export interface Props {
	/** Site-root path of the figure JSON, e.g. "/gallery/sine-waves/fig-1.plotly.json". */
	src: string;
	/** A small, static preview without legend, titles and tick labels (the cards of the gallery). */
	thumbnail?: boolean;
	/** A text alternative; default: the figure's `alt` hint. */
	alt?: string;
	/** Width over height, to reserve the space before the figure loads; default: the figure's `aspect` hint. */
	aspect?: number;
}
const { src, thumbnail = false, alt, aspect } = Astro.props;
---

<div
	class:list={['plotly-figure', { thumbnail, 'has-aspect': !thumbnail && aspect }]}
	data-plotly={withBase(src)}
	data-thumbnail={thumbnail ? '' : undefined}
	role="figure"
	aria-label={alt}
	style={!thumbnail && aspect ? `aspect-ratio: ${aspect}` : undefined}
>
	<span class="plotly-status" aria-live="polite">Loading figure…</span>
</div>

<script>
	import { PALETTE_SIZE, paletteFigure, themeControls, webHints, type Figure } from '../lib/plotly-theme.ts';

	type Layout = Record<string, any>;

	const css = (name: string) => getComputedStyle(document.documentElement).getPropertyValue(name).trim();

	const palette = () =>
		Array.from({ length: PALETTE_SIZE }, (_, i) => css(`--mm-data-${i + 1}`)).filter(Boolean);

	// Colours of the current theme, applied over whatever template the script's figure used.
	function themeLayout(layout: Layout, whitePlot = false): Layout {
		const text = css('--sl-color-text');
		const grid = css('--sl-color-hairline');
		const axis = { gridcolor: grid, zerolinecolor: css('--sl-color-hairline-light'), linecolor: css('--sl-color-hairline-light'), tickcolor: css('--sl-color-hairline-light') };
		const update: Layout = {
			paper_bgcolor: 'rgba(0,0,0,0)',
			plot_bgcolor: whitePlot ? 'white' : 'rgba(0,0,0,0)',
			'font.color': text,
			'font.family': css('--sl-font') || 'system-ui, sans-serif',
			'legend.bgcolor': 'rgba(0,0,0,0)',
		};
		const axisKey = /^[xyz]axis\d*$|^(polar|ternary|geo)\d*$/;
		for (const key of Object.keys(layout)) {
			if (axisKey.test(key)) {
				for (const [name, value] of Object.entries(axis)) update[`${key}.${name}`] = value;
			}
			if (/^scene\d*$/.test(key)) {
				for (const dim of ['xaxis', 'yaxis', 'zaxis']) {
					for (const [name, value] of Object.entries(axis)) update[`${key}.${dim}.${name}`] = value;
					update[`${key}.${dim}.backgroundcolor`] = 'rgba(0,0,0,0)';
				}
			}
		}
		for (const key of ['xaxis', 'yaxis']) for (const [name, value] of Object.entries(axis)) update[`${key}.${name}`] ??= value;
		return update;
	}

	function thumbnailLayout(layout: Layout): Layout {
		const update: Layout = {
			title: null,
			showlegend: false,
			autosize: true,
			height: null,
			width: null,
			margin: { l: 12, r: 12, t: 12, b: 12 },
			updatemenus: [],
			sliders: [],
		};
		for (const key of Object.keys(layout)) {
			if (/^[xy]axis\d*$/.test(key)) Object.assign(update, { [`${key}.showticklabels`]: false, [`${key}.title`]: null });
			if (/^scene\d*$/.test(key)) for (const dim of ['xaxis', 'yaxis', 'zaxis']) update[`${key}.${dim}.visible`] = false;
		}
		for (const key of ['xaxis', 'yaxis']) update[`${key}.showticklabels`] = false;
		return update;
	}

	// Plotly's relayout takes dotted paths; the initial layout takes nested objects.
	function expand(flat: Layout): Layout {
		const out: Layout = {};
		for (const [path, value] of Object.entries(flat)) {
			const keys = path.split('.');
			let node = out;
			for (const key of keys.slice(0, -1)) node = node[key] ??= {};
			node[keys.at(-1)!] = value;
		}
		return out;
	}
	function merge(target: Layout, source: Layout): Layout {
		for (const [key, value] of Object.entries(source)) {
			if (value && typeof value === 'object' && !Array.isArray(value) && target[key] && typeof target[key] === 'object') merge(target[key], value);
			else target[key] = value;
		}
		return target;
	}

	// The figure as plotted: the site's palette and theme colours over a copy of the file's figure.
	function themed(source: Figure, thumbnail: boolean) {
		// a white plot area keeps the figure's own colours, chosen for a white background
		const whitePlot = webHints(source).white_plot === true;
		const figure = whitePlot ? structuredClone(source) : paletteFigure(structuredClone(source), palette(), css('--sl-color-text'));
		const layout: Layout = figure.layout ?? {};
		layout.uirevision ??= 'theme'; // keep zoom and pan when the theme changes
		if (thumbnail) merge(layout, expand(thumbnailLayout(layout)));
		merge(layout, expand(themeLayout(layout, whitePlot)));
		const controls = themeControls(layout, {
			text: css('--sl-color-text'),
			background: css('--sl-color-gray-6'),
			border: css('--sl-color-hairline-light'),
			active: css('--sl-color-accent'),
		});
		return { data: figure.data, layout: controls, frames: thumbnail ? [] : figure.frames };
	}

	const rendered: { element: HTMLElement; figure: Figure; thumbnail: boolean; Plotly: any }[] = [];

	async function render(element: HTMLElement) {
		const thumbnail = element.hasAttribute('data-thumbnail');
		try {
			const [response, module] = await Promise.all([
				fetch(element.dataset.plotly!),
				// @ts-ignore: plotly.js ships no types
				import('plotly.js-dist-min'),
			]);
			if (!response.ok) throw new Error(`${response.status} ${response.statusText}`);
			const figure: Figure = await response.json();
			// plotly.js is a UMD build: bundled, it is the module's default export; served as is (the
			// dev server of a site that installs the theme), it only sets window.Plotly
			const Plotly = module.default ?? (typeof module.newPlot === 'function' ? module : (window as any).Plotly);
			const hints = webHints(figure);
			if (!thumbnail && !element.classList.contains('has-aspect') && typeof hints.aspect === 'number' && hints.aspect > 0) {
				element.style.aspectRatio = String(hints.aspect);
				element.classList.add('has-aspect');
			}
			if (!element.hasAttribute('aria-label') && (hints.alt || hints.title)) element.setAttribute('aria-label', (hints.alt || hints.title)!);
			// plotted into an inner box: Plotly sizes a plot to the border box of its element, which
			// would overflow the padding of the frame
			const plot = document.createElement('div');
			plot.style.width = '100%';
			plot.style.height = '100%';
			element.replaceChildren(plot);
			await Plotly.newPlot(plot, themed(figure, thumbnail), {
				responsive: true,
				displaylogo: false,
				staticPlot: thumbnail,
			});
			rendered.push({ element: plot, figure, thumbnail, Plotly });
		} catch (error) {
			element.textContent = `Could not load the figure (${(error as Error).message}).`;
		}
	}

	const observer = new IntersectionObserver(
		(entries) => {
			for (const entry of entries) {
				if (!entry.isIntersecting) continue;
				observer.unobserve(entry.target);
				render(entry.target as HTMLElement);
			}
		},
		{ rootMargin: '300px' }
	);
	document.querySelectorAll<HTMLElement>('[data-plotly]').forEach((element) => observer.observe(element));

	// the theme toggle sets data-theme on <html>
	new MutationObserver(() => {
		for (const { element, figure, thumbnail, Plotly } of rendered) Plotly.react(element, themed(figure, thumbnail));
	}).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
</script>

<style>
	.plotly-figure {
		min-height: 24rem;
		margin-block: 1.25rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.75rem;
		padding: 0.5rem;
		background: color-mix(in srgb, var(--sl-color-gray-5, #888) 8%, transparent);
	}
	.plotly-figure.has-aspect {
		min-height: 12rem;
	}
	.plotly-figure.thumbnail {
		min-height: 0;
		width: 100%;
		height: 100%;
		margin: 0;
		border: 0;
		border-radius: 0;
		padding: 0;
		background: none;
		pointer-events: none;
	}
	.plotly-status {
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
	}
</style>
