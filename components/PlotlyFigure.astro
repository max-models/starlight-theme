---
// An interactive Plotly figure, loaded from the JSON a gallery script's `fig.show()` left under
// public/ (written by the starlight-gallery tool). plotly.js is a separate chunk that is fetched
// only when a figure scrolls into view, and the figure follows the site's light/dark theme: text,
// grid and backgrounds, the data palette (--mm-data-1..8 in styles/theme.css) for the traces in
// a default colour, and the text colour for black ones. A web figure (maxplotlib.web, `*.plotly.json`) adds hints in
// layout.meta.web: its aspect ratio, a text alternative and a white plot area (see the README).
// Labels that are one `$...$` formula are typeset with MathJax, loaded with the first figure that
// has one, with the site's KaTeX macros (lib/mathjax.ts).
import config from 'virtual:starlight-theme/config';
import { withBase } from '../utils/base';

export interface Props {
	/** Site-root path of the figure JSON, e.g. "/gallery/sine-waves/fig-1.plotly.json". */
	src: string;
	/** A small, static preview without legend, titles and tick labels (the cards of the gallery). */
	thumbnail?: boolean;
	/** A text alternative; default: the figure's `alt` hint. */
	alt?: string;
	/** Width over height, to reserve the space before the figure loads; default: the figure's `aspect` hint. */
	aspect?: number;
	/** A caption below the figure. */
	caption?: string;
	/**
	 * Site-root path of a picture of the figure (e.g. a PNG written with it), shown until the
	 * figure has loaded and without JavaScript, e.g. for search engines and link previews.
	 */
	poster?: string;
	/** The poster for dark mode, e.g. drawn with light text; default: `poster` in both modes. */
	posterDark?: string;
}
const { src, thumbnail = false, alt, aspect, caption, poster, posterDark } = Astro.props;
const posterAlt = alt ?? caption ?? '';
// a poster that cannot be loaded (e.g. not written by the build) leaves the "Loading" text
const dropBroken = 'this.remove()';
const macros = Object.keys(config.math?.macros ?? {}).length ? JSON.stringify(config.math!.macros) : undefined;
---

<figure class:list={['plotly-wrap', { thumbnail }]} aria-label={alt}>
	<div
		class:list={['plotly-figure', { thumbnail, 'has-aspect': !thumbnail && aspect, 'has-poster': poster }]}
		data-plotly={withBase(src)}
		data-thumbnail={thumbnail ? '' : undefined}
		data-math-macros={macros}
		style={!thumbnail && aspect ? `--aspect: ${aspect}` : undefined}
	>
		{poster && (
			<img
				class:list={['plotly-poster', { 'dark:sl-hidden': posterDark }]}
				src={withBase(poster)}
				alt={posterAlt}
				loading="lazy"
				decoding="async"
				onerror={dropBroken}
			/>
		)}
		{poster && posterDark && (
			<img class="plotly-poster light:sl-hidden" src={withBase(posterDark)} alt={posterAlt} loading="lazy" decoding="async" onerror={dropBroken} />
		)}
		<span class="plotly-status" aria-live="polite">Loading figure…</span>
	</div>
	{caption && !thumbnail && <figcaption class="plotly-figcaption">{caption}</figcaption>}
</figure>

<script>
	import { COMPACT_QUERY, PALETTE_SIZE, calmLayout, compactFigure, hasControls, legendEntries, movableTitle, movableYTitle, paletteFigure, themeControls, titleText, webHints, type Figure } from '../lib/plotly-theme.ts';
	import { captionParts, formulaOf, hasMath, mathjaxConfig } from '../lib/mathjax.ts';
	// MathJax 3 (TeX to SVG), served as a file of its own: a classic script that sets window.MathJax
	// @ts-ignore: a URL import
	import mathjaxUrl from 'mathjax/es5/tex-svg.js?url';

	type Layout = Record<string, any>;

	const css = (name: string) => getComputedStyle(document.documentElement).getPropertyValue(name).trim();

	// A phone: the figure is laid out compact (and its frame is taller, in the CSS below); on a
	// touch screen a drag scrolls the page instead of zooming, and the toolbar, which a mouse
	// would show on hover, is hidden.
	const compact = matchMedia(COMPACT_QUERY);
	const touch = matchMedia('(pointer: coarse)');
	const config = (thumbnail: boolean) => ({
		responsive: true,
		displaylogo: false,
		staticPlot: thumbnail,
		displayModeBar: touch.matches ? false : 'hover',
		scrollZoom: false,
	});

	const palette = () =>
		Array.from({ length: PALETTE_SIZE }, (_, i) => css(`--mm-data-${i + 1}`)).filter(Boolean);

	// Colours of the current theme, applied over whatever template the script's figure used.
	function themeLayout(layout: Layout, whitePlot = false): Layout {
		const text = css('--sl-color-text');
		const grid = css('--sl-color-hairline');
		const axis = { gridcolor: grid, zerolinecolor: css('--sl-color-hairline-light'), linecolor: css('--sl-color-hairline-light'), tickcolor: css('--sl-color-hairline-light') };
		const update: Layout = {
			paper_bgcolor: 'rgba(0,0,0,0)',
			plot_bgcolor: whitePlot ? 'white' : 'rgba(0,0,0,0)',
			'font.color': text,
			'font.family': css('--sl-font') || 'system-ui, sans-serif',
			'legend.bgcolor': 'rgba(0,0,0,0)',
		};
		const axisKey = /^[xyz]axis\d*$|^(polar|ternary|geo)\d*$/;
		for (const key of Object.keys(layout)) {
			if (axisKey.test(key)) {
				for (const [name, value] of Object.entries(axis)) update[`${key}.${name}`] = value;
			}
			if (/^scene\d*$/.test(key)) {
				for (const dim of ['xaxis', 'yaxis', 'zaxis']) {
					for (const [name, value] of Object.entries(axis)) update[`${key}.${dim}.${name}`] = value;
					update[`${key}.${dim}.backgroundcolor`] = 'rgba(0,0,0,0)';
				}
			}
		}
		for (const key of ['xaxis', 'yaxis']) for (const [name, value] of Object.entries(axis)) update[`${key}.${name}`] ??= value;
		return update;
	}

	function thumbnailLayout(layout: Layout): Layout {
		const update: Layout = {
			title: null,
			showlegend: false,
			autosize: true,
			height: null,
			width: null,
			margin: { l: 12, r: 12, t: 12, b: 12 },
			updatemenus: [],
			sliders: [],
		};
		for (const key of Object.keys(layout)) {
			if (/^[xy]axis\d*$/.test(key)) Object.assign(update, { [`${key}.showticklabels`]: false, [`${key}.title`]: null });
			if (/^scene\d*$/.test(key)) for (const dim of ['xaxis', 'yaxis', 'zaxis']) update[`${key}.${dim}.visible`] = false;
		}
		for (const key of ['xaxis', 'yaxis']) update[`${key}.showticklabels`] = false;
		return update;
	}

	// Plotly's relayout takes dotted paths; the initial layout takes nested objects.
	function expand(flat: Layout): Layout {
		const out: Layout = {};
		for (const [path, value] of Object.entries(flat)) {
			const keys = path.split('.');
			let node = out;
			for (const key of keys.slice(0, -1)) node = node[key] ??= {};
			node[keys.at(-1)!] = value;
		}
		return out;
	}
	function merge(target: Layout, source: Layout): Layout {
		for (const [key, value] of Object.entries(source)) {
			if (value && typeof value === 'object' && !Array.isArray(value) && target[key] && typeof target[key] === 'object') merge(target[key], value);
			else target[key] = value;
		}
		return target;
	}

	// The figure as plotted: the site's palette and theme colours over a copy of the file's figure.
	// (`hidden`: the traces hidden with the legend below a phone's plot, see syncLegend)
	function themed(source: Figure, thumbnail: boolean, hidden: Set<number> = new Set()) {
		// a white plot area keeps the figure's own colours, chosen for a white background
		const whitePlot = webHints(source).white_plot === true;
		const figure = whitePlot
			? structuredClone(source)
			: paletteFigure(structuredClone(source), palette(), css('--sl-color-text'), css('--sl-color-bg'));
		figure.data?.forEach((trace, index) => {
			if (hidden.has(index)) trace.visible = 'legendonly';
		});
		const layout: Layout = figure.layout ?? {};
		layout.uirevision ??= 'theme'; // keep zoom and pan when the theme changes
		if (thumbnail) merge(layout, expand(thumbnailLayout(layout)));
		merge(layout, expand(themeLayout(layout, whitePlot)));
		// axes, labels and annotations as web charts draw them; a white plot area keeps its own
		const calm = whitePlot
			? layout
			: calmLayout(layout, {
					text: css('--sl-color-text'),
					muted: css('--sl-color-gray-2'),
					line: css('--sl-color-hairline-light'),
					grid: css('--sl-color-hairline'),
					background: css('--sl-color-bg'),
					hover: css('--sl-color-gray-6'),
					font: css('--sl-font') || 'system-ui, sans-serif',
				}, figure.data);
		const controls = themeControls(calm, {
			text: css('--sl-color-text'),
			background: css('--sl-color-gray-6'),
			border: css('--sl-color-hairline-light'),
			active: css('--sl-color-accent'),
		});
		if (!thumbnail && touch.matches) controls.dragmode = false;
		const shown = { data: figure.data, layout: controls, frames: thumbnail ? [] : figure.frames };
		return !thumbnail && compact.matches ? compactFigure(shown) : shown;
	}

	const rendered: { element: HTMLElement; figure: Figure; thumbnail: boolean; Plotly: any; hidden: Set<number> }[] = [];

	// MathJax, once per page, for the figures with formulas; plotly.js finds it as window.MathJax
	let mathjax: Promise<any> | null = null;
	function loadMathJax(macros: Record<string, string>): Promise<any> {
		const global = window as any;
		mathjax ??= new Promise((resolve, reject) => {
			if (global.MathJax?.startup?.promise) return resolve(global.MathJax.startup.promise);
			global.MathJax = mathjaxConfig(macros, css('--sl-font') || 'system-ui, sans-serif');
			const script = document.createElement('script');
			script.src = mathjaxUrl;
			script.async = true;
			script.onload = () =>
				resolve(
					global.MathJax.startup.promise.then(() => {
						// the styles of MathJax's output (and its hidden copy for screen readers), which
						// the page gets only from a typeset of the page, which KaTeX does here
						document.head.append(global.MathJax.svgStylesheet());
					})
				);
			script.onerror = () => reject(new Error('MathJax could not be loaded'));
			document.head.append(script);
		}).then(() => global.MathJax);
		return mathjax;
	}

	// a label as text: typeset when it is a formula and MathJax is loaded, else with its sub- and
	// superscripts (Plotly's markup)
	function setText(target: HTMLElement, text: string) {
		const tex = formulaOf(text);
		const MathJax = (window as any).MathJax;
		if (tex && MathJax?.tex2svg) return target.replaceChildren(MathJax.tex2svg(tex, { display: false }));
		target.replaceChildren(
			...captionParts(text).map(({ tag, text }) => {
				if (!tag) return document.createTextNode(text);
				const element = document.createElement(tag);
				element.textContent = text;
				return element;
			})
		);
	}

	// On a phone the title of the figure and the title of its y axis are text above the plot, where
	// they wrap (see movableTitle and movableYTitle).
	function syncCaption(plot: HTMLElement, figure: Figure, thumbnail: boolean) {
		const shown = !thumbnail && compact.matches;
		const title = shown && movableTitle(figure) ? titleText(figure.layout?.title) : '';
		const yTitle = shown ? movableYTitle(figure) : '';
		let caption = plot.previousElementSibling as HTMLElement | null;
		if (!title && !yTitle) return caption?.remove();
		if (!caption) {
			caption = document.createElement('div');
			caption.className = 'plotly-caption';
			plot.before(caption);
		}
		const lines: HTMLElement[] = [];
		for (const [text, className] of [[title, 'plotly-caption-title'], [yTitle, 'plotly-caption-axis']]) {
			if (!text) continue;
			const line = document.createElement('div');
			line.className = className;
			setText(line, text);
			lines.push(line);
		}
		caption.replaceChildren(...lines);
	}

	const SVG = 'http://www.w3.org/2000/svg';
	const first = (value: unknown) => (Array.isArray(value) ? value[0] : value);

	// The sample of a trace in the legend: its line, its marker or a filled square, in the colours
	// Plotly drew it with.
	function swatch(trace: Record<string, any> | undefined): SVGSVGElement {
		const svg = document.createElementNS(SVG, 'svg');
		svg.setAttribute('viewBox', '0 0 24 12');
		svg.setAttribute('aria-hidden', 'true');
		svg.classList.add('plotly-legend-swatch');
		const add = (tag: string, attributes: Record<string, string | number>) => {
			const node = document.createElementNS(SVG, tag);
			for (const [name, value] of Object.entries(attributes)) node.setAttribute(name, String(value));
			svg.append(node);
		};
		const type = trace?.type ?? 'scatter';
		const mode: string = trace?.mode ?? (type.startsWith('scatter') ? 'lines' : '');
		const lineColor = first(trace?.line?.color);
		const markerColor = first(trace?.marker?.color) ?? lineColor;
		const fill = trace?.fill && trace.fill !== 'none' ? trace.fillcolor : undefined;
		if (fill || !/lines|markers/.test(mode)) {
			const color = fill ?? (typeof markerColor === 'string' ? markerColor : undefined) ?? 'currentColor';
			add('rect', { x: 5, y: 1, width: 14, height: 10, rx: 2, fill: color, stroke: lineColor ?? 'none' });
			return svg;
		}
		if (mode.includes('lines') && (trace?.line?.width ?? 2) > 0) {
			const dash: string = trace?.line?.dash ?? 'solid';
			const dasharray = { dot: '1.5 2.5', dash: '5 3', longdash: '8 3', dashdot: '5 2 1.5 2', longdashdot: '8 2 1.5 2' }[dash] ?? (/^[\d.\s,px]+$/.test(dash) && dash !== 'solid' ? dash : '');
			add('line', { x1: 1, y1: 6, x2: 23, y2: 6, stroke: lineColor ?? 'currentColor', 'stroke-width': Math.min(Math.max(trace?.line?.width ?? 2, 1.5), 4), ...(dasharray ? { 'stroke-dasharray': dasharray } : {}) });
		}
		if (mode.includes('markers')) {
			const symbol = String(first(trace?.marker?.symbol) ?? 'circle');
			const color = typeof markerColor === 'string' ? markerColor : 'currentColor';
			const edge = first(trace?.marker?.line?.color);
			if (/^(x|cross)/.test(symbol)) {
				const d = symbol.startsWith('x') ? 'M8.5 2.5 15.5 9.5M15.5 2.5 8.5 9.5' : 'M12 1.5V10.5M7.5 6H16.5';
				add('path', { d, stroke: edge && trace?.marker?.line?.width ? edge : color, 'stroke-width': 2, 'stroke-linecap': 'round' });
			} else if (/^square/.test(symbol)) add('rect', { x: 8.5, y: 2.5, width: 7, height: 7, fill: color });
			else add('circle', { cx: 12, cy: 6, r: 3.5, fill: color });
		}
		return svg;
	}

	// On a phone the main legend is a list below the plot, where it wraps and adds to the height of
	// the figure instead of taking rows from the plot (compactFigure leaves it out of the plot). A
	// tap on an item hides its traces, as a click on Plotly's legend does.
	function syncLegend(item: (typeof rendered)[number]) {
		const { element: plot, figure, thumbnail, Plotly, hidden } = item;
		const { title, entries } = !thumbnail && compact.matches ? legendEntries(figure) : { title: '', entries: [] };
		let legend = plot.nextElementSibling as HTMLElement | null;
		if (!entries.length) return legend?.remove();
		if (!legend) {
			legend = document.createElement('div');
			legend.className = 'plotly-legend';
			legend.setAttribute('role', 'group');
			plot.after(legend);
		}
		const items: HTMLElement[] = [];
		if (title) {
			const heading = document.createElement('span');
			heading.className = 'plotly-legend-title';
			setText(heading, title);
			items.push(heading);
		}
		const drawn: Record<string, any>[] = (plot as any)._fullData ?? [];
		for (const entry of entries) {
			const button = document.createElement('button');
			button.type = 'button';
			button.className = 'plotly-legend-item';
			button.setAttribute('aria-pressed', String(!hidden.has(entry.trace)));
			const label = document.createElement('span');
			setText(label, entry.name);
			button.append(swatch(drawn.find((trace) => trace.index === entry.trace) ?? figure.data?.[entry.trace]), label);
			button.addEventListener('click', () => {
				const hide = !hidden.has(entry.trace);
				for (const index of entry.group) hide ? hidden.add(index) : hidden.delete(index);
				Plotly.restyle(plot, { visible: hide ? 'legendonly' : true }, entry.group);
				for (const other of legend!.querySelectorAll<HTMLElement>('[data-trace]')) other.setAttribute('aria-pressed', String(!hidden.has(Number(other.dataset.trace))));
			});
			button.dataset.trace = String(entry.trace);
			items.push(button);
		}
		legend.replaceChildren(...items);
	}

	async function render(element: HTMLElement) {
		const thumbnail = element.hasAttribute('data-thumbnail');
		try {
			const [response, module] = await Promise.all([
				fetch(element.dataset.plotly!),
				// @ts-ignore: plotly.js ships no types
				import('plotly.js-dist-min'),
			]);
			if (!response.ok) throw new Error(`${response.status} ${response.statusText}`);
			const figure: Figure = await response.json();
			// a thumbnail shows no labels: no MathJax for it
			if (!thumbnail && hasMath(figure)) {
				await loadMathJax(JSON.parse(element.dataset.mathMacros ?? '{}')).catch(() => null); // without it, the labels as written
			}
			// plotly.js is a UMD build: bundled, it is the module's default export; served as is (the
			// dev server of a site that installs the theme), it only sets window.Plotly
			const Plotly = module.default ?? (typeof module.newPlot === 'function' ? module : (window as any).Plotly);
			const hints = webHints(figure);
			if (!thumbnail && !element.classList.contains('has-aspect') && typeof hints.aspect === 'number' && hints.aspect > 0) {
				element.style.setProperty('--aspect', String(hints.aspect));
				element.classList.add('has-aspect');
			}
			if (hasControls(figure)) element.classList.add('has-controls');
			const wrap = element.closest('figure') ?? element;
			if (!wrap.hasAttribute('aria-label') && !wrap.querySelector('figcaption') && (hints.alt || hints.title)) wrap.setAttribute('aria-label', (hints.alt || hints.title)!);
			// plotted into an inner box: Plotly sizes a plot to the border box of its element, which
			// would overflow the padding of the frame
			const plot = document.createElement('div');
			plot.className = 'plotly-plot';
			element.replaceChildren(plot);
			syncCaption(plot, figure, thumbnail);
			// with a figure object, Plotly reads the config from the object, not from a third argument
			await Plotly.newPlot(plot, { ...themed(figure, thumbnail), config: config(thumbnail) });
			// plotly.js lays out axes of equal scale (scaleanchor) before MathJax has typeset the
			// legend and titles, which then take another size: laid out again, they are equal
			if (hasMath(figure)) await Plotly.redraw(plot);
			const item = { element: plot, figure, thumbnail, Plotly, hidden: new Set<number>() };
			rendered.push(item);
			syncLegend(item);
			element.classList.add('is-drawn');
		} catch (error) {
			element.textContent = `Could not load the figure (${(error as Error).message}).`;
		}
	}

	const observer = new IntersectionObserver(
		(entries) => {
			for (const entry of entries) {
				if (!entry.isIntersecting) continue;
				observer.unobserve(entry.target);
				render(entry.target as HTMLElement);
			}
		},
		{ rootMargin: '300px' }
	);
	document.querySelectorAll<HTMLElement>('[data-plotly]').forEach((element) => observer.observe(element));

	const redraw = () => {
		for (const item of rendered) {
			const { element, figure, thumbnail, Plotly, hidden } = item;
			syncCaption(element, figure, thumbnail);
			Promise.resolve(Plotly.react(element, { ...themed(figure, thumbnail, hidden), config: config(thumbnail) }))
				.then(() => hasMath(figure) && Plotly.redraw(element)) // as in render
				.then(() => syncLegend(item));
		}
	};
	// the theme toggle sets data-theme on <html>; a phone turned sideways can leave the compact width
	new MutationObserver(redraw).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
	compact.addEventListener('change', redraw);
	touch.addEventListener('change', redraw);
</script>

<style>
	.plotly-wrap {
		margin: 1.25rem 0;
	}
	.plotly-wrap.thumbnail {
		margin: 0;
		width: 100%;
		height: 100%;
	}
	.plotly-figcaption {
		margin-top: 0.5rem;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		text-align: center;
	}
	.plotly-figure {
		display: flex;
		flex-direction: column;
		min-height: 24rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.75rem;
		padding: 0.5rem;
		background: color-mix(in srgb, var(--sl-color-gray-5, #888) 8%, transparent);
	}
	.plotly-figure.has-aspect {
		aspect-ratio: var(--aspect);
		min-height: 12rem;
	}
	/* a phone (COMPACT_QUERY in lib/plotly-theme.ts): the plot at most 1.1 times as wide as tall,
	   and at most 0.85 with a slider or buttons, so that it keeps a usable height. Once drawn, the
	   ratio is the plot's alone: the titles above it and the legend below it add to the height of
	   the frame instead of taking it from the plot. */
	@media (max-width: 40rem) {
		.plotly-figure {
			min-height: 20rem;
			padding: 0.25rem;
		}
		.plotly-figure.has-aspect {
			aspect-ratio: min(var(--aspect), 1.1);
			min-height: 16rem;
		}
		.plotly-figure.has-aspect.has-controls {
			aspect-ratio: min(var(--aspect), 0.85);
		}
		.plotly-figure.is-drawn:not(.thumbnail) {
			aspect-ratio: auto;
			min-height: 0;
		}
		.plotly-figure.is-drawn:not(.thumbnail) :global(.plotly-plot) {
			flex: none;
			height: 19.5rem;
		}
		.plotly-figure.has-aspect.is-drawn :global(.plotly-plot) {
			height: auto;
		}
		.plotly-figure.has-aspect.is-drawn :global(.plotly-plot) {
			flex: none;
			aspect-ratio: min(var(--aspect), 1.1);
			min-height: 14rem;
		}
		.plotly-figure.has-aspect.has-controls.is-drawn :global(.plotly-plot) {
			aspect-ratio: min(var(--aspect), 0.85);
		}
	}
	.plotly-figure.thumbnail {
		min-height: 0;
		width: 100%;
		height: 100%;
		margin: 0;
		border: 0;
		border-radius: 0;
		padding: 0;
		background: none;
		pointer-events: none;
	}
	/* the plot and, on a phone, the title above it; created by the script, hence :global */
	.plotly-figure :global(.plotly-plot) {
		flex: 1 1 auto;
		min-height: 0;
		width: 100%;
	}
	.plotly-figure :global(.plotly-caption) {
		padding: 0.5rem 0.5rem 0;
		line-height: 1.3;
	}
	.plotly-figure :global(.plotly-caption-title) {
		font-weight: 600;
		text-align: center;
	}
	/* the y axis's title, above the axis as web charts on phones show it */
	.plotly-figure :global(.plotly-caption-axis) {
		margin-top: 0.25rem;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-xs);
	}
	/* the legend below a phone's plot (syncLegend): items that wrap, a tap hides a trace */
	.plotly-figure :global(.plotly-legend) {
		display: flex;
